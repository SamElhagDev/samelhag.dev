            <MudPaper Elevation="0" Class="glass-card glass-card--cyan pa-6" Style="height: 100%;">
                <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
                    <div class="icon-box icon-box--md icon-box--blue">
                        <MudIcon Icon="@Icons.Material.Filled.LibraryMusic" Style="color: white; font-size: 1.8rem;" />
                    </div>
                    <MudText Typo="Typo.h5" Class="text-white-bold" Style="margin-left: 12px;">Music</MudText>
                </MudStack>
                <MudChipSet T="string">
                    <MudChip T="string" Class="chip-red">Aphex Twin</MudChip>
                    <MudChip T="string" Class="chip-red">µ-Ziq</MudChip>
                    <MudChip T="string" Class="chip-red">Squarepusher</MudChip>
                    <MudChip T="string" Class="chip-red">Rob Clouth</MudChip>
                    <MudChip T="string" Class="chip-red">Telefon Tel Aviv</MudChip>
                    <MudChip T="string" Class="chip-red">Jon Hopkins</MudChip>
