@page "/Interests"
@using MudBlazor
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<MudContainer>
    <!-- Media Section -->
    <MudText Typo="Typo.h3" Align="Align.Center" GutterBottom="true" Class="mb-4 text-white-bold">
        Interests
    </MudText>
    <MudText Typo="Typo.h6" Align="Align.Center" Class="mb-10 text-muted-60" Style="font-weight: 400;">
        What I consume, When Not Building
    </MudText>

    <MudGrid Spacing="4">
        <!-- Music -->
        <MudItem xs="12" md="6">
            <MudPaper Elevation="0" Class="glass-card glass-card--cyan pa-6" Style="height: 100%;">
                <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
                    <div class="icon-box icon-box--md icon-box--blue">
                        <MudIcon Icon="@Icons.Material.Filled.LibraryMusic" Style="color: white; font-size: 1.8rem;" />
                    </div>
                    <MudText Typo="Typo.h5" Class="text-white-bold" Style="margin-left: 12px;">Music</MudText>
                </MudStack>
                <MudChipSet T="string">
                    <MudChip T="string" Class="chip-red">Aphex Twin</MudChip>
                    <MudChip T="string" Class="chip-red">µ-Ziq</MudChip>
                    <MudChip T="string" Class="chip-red">Squarepusher</MudChip>
                    <MudChip T="string" Class="chip-red">Rob Clouth</MudChip>
                    <MudChip T="string" Class="chip-red">Telefon Tel Aviv</MudChip>
                    <MudChip T="string" Class="chip-red">Jon Hopkins</MudChip>
                    <MudChip T="string" Class="chip-red">Boards Of Canada</MudChip>
                    <MudChip T="string" Class="chip-red">Polygon Window</MudChip>
                    <MudChip T="string" Class="chip-red">Arovane</MudChip>
                    <MudChip T="string" Class="chip-red">Wisp</MudChip>
                    <MudChip T="string" Class="chip-red">Roni Size Reprazent</MudChip>
                    <MudChip T="string" Class="chip-red">Daft Punk</MudChip>
                </MudChipSet>
            </MudPaper>
        </MudItem>

        <!-- TV and Movies -->
        <MudItem xs="12" md="6">
            <MudPaper Elevation="0" Class="glass-card glass-card--cyan pa-6" Style="height: 100%;">
                <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
                    <div class="icon-box icon-box--md icon-box--cyan">
                        <MudIcon Icon="@Icons.Material.Filled.Tv" Style="color: white; font-size: 1.8rem;" />
                    </div>
                    <MudText Typo="Typo.h5" Class="text-white-bold" Style="margin-left: 12px;">TV and Movies</MudText>
                </MudStack>
                <MudChipSet T="string">
                    <MudChip T="string" Class="chip-red">The Expanse</MudChip>
                    <MudChip T="string" Class="chip-red">Dune</MudChip>
                    <MudChip T="string" Class="chip-red">Interstellar</MudChip>
                    <MudChip T="string" Class="chip-red">Oppenheimer</MudChip>
                    <MudChip T="string" Class="chip-red">Blade Runner 2049</MudChip>
                    <MudChip T="string" Class="chip-red">Chernobyl</MudChip>
                    <MudChip T="string" Class="chip-red">For All Mankind</MudChip>
                    <MudChip T="string" Class="chip-red">Foundation</MudChip>
                    <MudChip T="string" Class="chip-red">Band of Brothers</MudChip>
                    <MudChip T="string" Class="chip-red">The Wire</MudChip>
                    <MudChip T="string" Class="chip-red">Severance</MudChip>
                    <MudChip T="string" Class="chip-red">Arcane</MudChip>
                </MudChipSet>
            </MudPaper>
        </MudItem>

        <!-- Gaming -->
        <MudItem xs="12" md="6">
            <MudPaper Elevation="0" Class="glass-card glass-card--cyan pa-6" Style="height: 100%;">
                <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
                    <div class="icon-box icon-box--md icon-box--blue">
                        <MudIcon Icon="@Icons.Material.Filled.Games" Style="color: white; font-size: 1.8rem;" />
                    </div>
                    <MudText Typo="Typo.h5" Class="text-white-bold" Style="margin-left: 12px;">Gaming</MudText>
                </MudStack>
                <MudChipSet T="string">
                    <MudChip T="string" Class="chip-red">Escape from Tarkov</MudChip>
                    <MudChip T="string" Class="chip-red">CS2</MudChip>
                    <MudChip T="string" Class="chip-red">Civ VI</MudChip>
                    <MudChip T="string" Class="chip-red">Rust</MudChip>
                    <MudChip T="string" Class="chip-red">Homeworld 2</MudChip>
                    <MudChip T="string" Class="chip-red">WARNO</MudChip>
                    <MudChip T="string" Class="chip-red">Insurgency: Sandstorm</MudChip>
                    <MudChip T="string" Class="chip-red">Fallout 4</MudChip>
                </MudChipSet>
            </MudPaper>
        </MudItem>

        <!-- Firearms -->
        <MudItem xs="12" md="6">
            <MudPaper Elevation="0" Class="glass-card glass-card--cyan pa-6" Style="height: 100%;">
                <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
                    <div class="icon-box icon-box--md icon-box--cyan">
                        <MudIcon Icon="@Icons.Material.Filled.Build" Style="color: white; font-size: 1.8rem;" />
                    </div>
                    <MudText Typo="Typo.h5" Class="text-white-bold" Style="margin-left: 12px;">Firearms</MudText>
                </MudStack>
                <MudChipSet T="string">
                    <MudChip T="string" Class="chip-red">AR-15</MudChip>
                    <MudChip T="string" Class="chip-red">AK Platform</MudChip>
                    <MudChip T="string" Class="chip-red">Bolt-action rifles</MudChip>
                    <MudChip T="string" Class="chip-red">Pistols</MudChip>
                    <MudChip T="string" Class="chip-red">9mm</MudChip>
                    <MudChip T="string" Class="chip-red">5.56 NATO</MudChip>
                    <MudChip T="string" Class="chip-red">.308 Win</MudChip>
                    <MudChip T="string" Class="chip-red">Optics</MudChip>
                    <MudChip T="string" Class="chip-red">Marksmanship</MudChip>
                    <MudChip T="string" Class="chip-red">Range days</MudChip>
                    <MudChip T="string" Class="chip-red">Reloading</MudChip>
                </MudChipSet>
            </MudPaper>
        </MudItem>

        <!-- Art -->
        <MudItem xs="12" md="6">
            <MudPaper Elevation="0" Class="glass-card glass-card--cyan pa-6" Style="height: 100%;">
                <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
                    <div class="icon-box icon-box--md icon-box--silver-red">
                        <MudIcon Icon="@Icons.Material.Filled.FormatPaint" Style="color: white; font-size: 1.8rem;" />
                    </div>
                    <MudText Typo="Typo.h5" Class="text-white-bold" Style="margin-left: 12px;">Art</MudText>
                </MudStack>
                <MudChipSet T="string">
                    <MudChip T="string" Class="chip-red">Generative art</MudChip>
                    <MudChip T="string" Class="chip-red">Bauhaus</MudChip>
                    <MudChip T="string" Class="chip-red">Brutalist architecture</MudChip>
                    <MudChip T="string" Class="chip-red">Industrial design</MudChip>
                    <MudChip T="string" Class="chip-red">Typography</MudChip>
                    <MudChip T="string" Class="chip-red">Minimalism</MudChip>
                    <MudChip T="string" Class="chip-red">Concept art</MudChip>
                    <MudChip T="string" Class="chip-red">Photography</MudChip>
                    <MudChip T="string" Class="chip-red">Data visualization</MudChip>
                    <MudChip T="string" Class="chip-red">Mid-century modern</MudChip>
                </MudChipSet>
            </MudPaper>
        </MudItem>

        <!-- Electrionics -->
        <MudItem xs="12" md="6">
            <MudPaper Elevation="0" Class="glass-card glass-card--cyan pa-6" Style="height: 100%;">
                <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
                    <div class="icon-box icon-box--md icon-box--red">
                        <MudIcon Icon="@Icons.Material.Filled.ElectricBolt" Style="color: white; font-size: 1.8rem;" />
                    </div>
                    <MudText Typo="Typo.h5" Class="text-white-bold" Style="margin-left: 12px;">Electronics</MudText>
                </MudStack>
                <MudChipSet T="string">
                    <MudChip T="string" Class="chip-red">Arduino</MudChip>
                    <MudChip T="string" Class="chip-red">Raspberry Pi</MudChip>
                    <MudChip T="string" Class="chip-red">ESP32</MudChip>
                    <MudChip T="string" Class="chip-red">Microcontrollers</MudChip>
                    <MudChip T="string" Class="chip-red">Soldering</MudChip>
                    <MudChip T="string" Class="chip-red">SolidWorks</MudChip>
                    <MudChip T="string" Class="chip-red">3D printing</MudChip>
                    <MudChip T="string" Class="chip-red">Mechanical keyboards</MudChip>
                    <MudChip T="string" Class="chip-red">DAC/Amp</MudChip>
                    <MudChip T="string" Class="chip-red">Home lab</MudChip>
                    <MudChip T="string" Class="chip-red">Hi-Fi</MudChip>
                </MudChipSet>
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudContainer>


