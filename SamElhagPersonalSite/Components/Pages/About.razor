@page "/about"
@using MudBlazor
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>Who I Am - Sam Elhag</PageTitle>

<style>
    /* Syntax highlighting — Copper theme */
    .syn-kw      { color: #fb923c; }
    .syn-tp      { color: #f97316; }
    .syn-prop    { color: #f5ede0; }
    .syn-str     { color: #a89070; }
    .syn-num     { color: #d4a574; }
    .syn-comment { color: #6e5a48; }
    .syn-iface-d { color: #fb923c; }
    .syn-iface-a { color: #ea580c; }
    .syn-iface-e { color: #a89070; }
    .syn-iface-p { color: #a89070; }
    .syn-iface-g { color: #fb923c; }
    .syn-iface-m { color: #ea580c; }

    .wia-code-block {
        background: rgba(0, 0, 0, 0.25);
        border-radius: 8px;
        padding: 12px;
        margin: 0;
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.75rem;
        line-height: 1.65;
        overflow-x: auto;
        white-space: pre;
    }

    .wia-inner-card {
        background: var(--bc-bg-deep);
        border-radius: var(--bc-radius);
        padding: 18px;
        min-width: 0;
        transition: background 0.2s;
    }
    .wia-inner-card:hover {
        background: var(--bc-bg-primary);
    }
</style>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-8" Style="max-width: 1800px;">

    <!-- Section header -->
    <MudText Typo="Typo.h2" Align="Align.Center" GutterBottom="true" Class="mb-4 text-heading-bold" Style="color: #f5ede0;">
       Anatomy of a Sam.E
    </MudText>

    <!-- View toggle -->
    <div style="display: flex; justify-content: center; margin-bottom: 24px;">
        <MudButton Variant="Variant.Filled" Size="Size.Medium"
                   StartIcon="@(showModel ? Icons.Material.Filled.Description : Icons.Material.Filled.Code)"
                   Class="btn-outlined-blue"
                   Style="padding: 8px 24px;"
                   OnClick="@(() => showModel = !showModel)">
            @(showModel ? "Words" : "Model")
        </MudButton>
    </div>

    <!-- ═══ Sam.E outer container ═══ -->
    <MudPaper Elevation="0" Style="background: var(--bc-bg-surface); border: 1px solid var(--bc-accent-border); border-radius: var(--bc-radius-lg); padding: 28px; box-shadow: none;">

        <!-- Header row -->
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4" Spacing="3">
            <div class="icon-box icon-box--md icon-box--brand">
                <MudIcon Icon="@Icons.Material.Filled.Person" Style="color: white; font-size: 1.8rem;" />
            </div>
            <MudText Style="color: #f5ede0; font-weight: 700; font-family: 'JetBrains Mono', monospace; font-size: 1.25rem;">Sam.E</MudText>
        </MudStack>

        @if (!showModel)
        {
            <!-- ═══ Words view ═══ -->
            <div class="wia-inner-card" style="border: 1px solid rgba(249, 115, 22, 0.25); padding: 28px; max-width: 900px; margin: 0 auto;">
                <MudText Class="mb-4" Style="color: rgba(245,237,224,0.7); font-size: 1.05rem; line-height: 1.85;">
                    Description:
                    Developer - Analyst - Engineer
                </MudText>

                <MudText Class="mb-4" Style="color: rgba(245,237,224,0.7); font-size: 1.05rem; line-height: 1.85;">
                    Professional Summary:
                    Software Engineer with an interest in robotics. Educational background in  mechanical engineering
                    (Bachelors of Science) with additional courses in robotics, and professional experience in software
                    development.
                </MudText>

                <MudText Class="mb-4" Style="color: rgba(245,237,224,0.7); font-size: 1.05rem; line-height: 1.85;">
                    Academic Interests:
                    Main interests include object-oriented programming, data analysis, materials science, and control
                    system analysis.
                </MudText>

                <MudText Style="color: rgba(245,237,224,0.7); font-size: 1.05rem; line-height: 1.85;">
                    Professional Strengths:
                    General strengths include proficiency in a wide scope of programming languages and frameworks,
                    strong problem solving skills, and demonstrated effectiveness on teams  employing Agile methodologies.
                </MudText>
            </div>
        }
        else
        {

        <!-- ── Interface definitions comment ── -->
        <div style="font-family: 'JetBrains Mono', monospace; font-size: 0.82rem; color: #6e5a48; margin: 4px 0 14px 4px;">// ── Interfaces ──</div>

        <!-- ── 3x2 interface grid ── -->
        <div style="display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px;">

            <!-- IDeveloper -->
            <div class="wia-inner-card" style="border: 1px solid rgba(249, 115, 22, 0.25);">
