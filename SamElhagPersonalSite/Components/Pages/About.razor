@page "/about"
@using System.Globalization
@using System.Net
@using System.Text

<Seo Title="About"
     Description="Sam Elhag: B.S. in mechanical engineering with robotics coursework, professional software development experience, and interests from control systems to policy."
     Path="/about" />

<div class="container container--wide">
    <div class="about-head">
        <PageHeader Eyebrow="~/about" Title="Anatomy of a Sam.E" />
        <div class="segmented" role="group" aria-label="View">
            <button type="button" class="segmented__btn" aria-pressed="@(_showModel ? "false" : "true")" @onclick="() => _showModel = false">
                <Icon Svg="@Icons.Material.Outlined.Description" />
                Words
            </button>
            <button type="button" class="segmented__btn" aria-pressed="@(_showModel ? "true" : "false")" @onclick="() => _showModel = true">
                <Icon Svg="@Icons.Material.Outlined.Code" />
                Model
            </button>
        </div>
    </div>

    <section class="card card--featured about-panel" aria-label="Profile">
        <div class="about-panel__head">
            <span class="icon-tile"><Icon Svg="@Icons.Material.Outlined.Person" /></span>
            <span class="about-panel__name">Sam.E</span>
        </div>

        @if (!_showModel)
        {
            <dl class="profile">
                @foreach (var (term, detail) in Profile)
                {
                    <div class="profile__row">
                        <dt>@term</dt>
                        <dd>@detail</dd>
                    </div>
                }
            </dl>
        }
        else
        {
            <h2 class="code-comment"><span aria-hidden="true">// ── </span>Interfaces<span aria-hidden="true"> ──</span></h2>
            <div class="code-grid">
                @foreach (var facet in Facets)
                {
                    <article class="code-card">
                        <header class="code-card__head">
                            <span class="icon-tile icon-tile--sm"><Icon Svg="@facet.Icon" /></span>
                            <h3 class="code-card__name syn-iface--@facet.Tone">@facet.Name</h3>
                        </header>
                        <pre class="code-block"><code>@InterfaceCode(facet)</code></pre>
                    </article>
                }
            </div>

            <h2 class="code-comment"><span aria-hidden="true">// ── </span>Implementation<span aria-hidden="true"> ──</span></h2>
            <p class="code-line">@ClassDeclaration()</p>
            <p class="code-brace" aria-hidden="true">{</p>

            <div class="code-core">
                <article class="code-card">
                    <header class="code-card__head">
                        <span class="icon-tile icon-tile--sm"><Icon Svg="@Icons.Material.Outlined.Star" /></span>
                        <h3 class="code-card__name syn-tp">SamE</h3>
                    </header>
                    <pre class="code-block"><code>@CoreCode()</code></pre>
                </article>
            </div>

            <div class="code-grid">
                @foreach (var facet in Facets)
                {
                    <article class="code-card">
                        <header class="code-card__head">
                            <span class="icon-tile icon-tile--sm"><Icon Svg="@facet.Icon" /></span>
                            <h3 class="code-card__name syn-iface--@facet.Tone">@facet.Name</h3>
                        </header>
                        <pre class="code-block"><code>@ImplementationCode(facet)</code></pre>
                    </article>
                }
            </div>

            <p class="code-brace" aria-hidden="true">}</p>
        }
    </section>
</div>

@code {
    private bool _showModel;

    private static readonly (string Term, string Detail)[] Profile =
    [
        ("Description", "Developer · Analyst · Engineer"),
        ("Professional summary", "Software Engineer with an interest in robotics. Educational background in mechanical engineering (Bachelor of Science) with additional courses in robotics, and professional experience in software development."),
        ("Academic interests", "Main interests include object-oriented programming, data analysis, materials science, and control system analysis."),
        ("Professional strengths", "General strengths include proficiency in a wide scope of programming languages and frameworks, strong problem-solving skills, and demonstrated effectiveness on teams employing Agile methodologies."),
    ];

    // ── The "Model" view: each facet renders as a C# interface plus its implementation ──

    private sealed record Member(string Type, string Name, object Value);

    /// <param name="Tone">Suffix of the .syn-iface--* colour class.</param>
    private sealed record Facet(string Name, string Icon, string Tone, Member[] Members);

    private static readonly Facet[] Facets =
    [
        new("IDeveloper", Icons.Material.Outlined.Code, "d",
        [
            new("bool", "WritesCleanCode", true),
            new("bool", "FullStack", true),
            new("bool", "Automates", true),
            new("string[]", "Languages", new[] { "C#", "Rust", "F#", "TypeScript" }),
            new("string[]", "Frameworks", new[] { ".NET", "Blazor", "ASP.NET", "Angular" }),
            new("string", "PreferredPattern", "Clean Architecture"),
        ]),
        new("IAnalyst", Icons.Material.Outlined.Analytics, "a",
        [
            new("bool", "DataDriven", true),
            new("bool", "DetailOriented", true),
            new("bool", "FindsRootCause", true),
            new("string[]", "Tools", new[] { "SQL Server", "SSMS", "Power BI" }),
            new("string", "Domain", "Business Intelligence"),
            new("string", "Approach", "Measure, Analyze, Iterate"),
        ]),
        new("IMechanicalEngineer", Icons.Material.Outlined.Engineering, "e",
        [
            new("bool", "SystemsThinker", true),
            new("bool", "BuildsToSpec", true),
            new("string", "Degree", "B.S. Mechanical Engineering"),
            new("string[]", "Disciplines", new[] { "Thermo", "Fluids", "Heat Transfer" }),
            new("string[]", "Software", new[] { "SolidWorks", "AutoCAD", "MATLAB" }),
            new("bool", "PrecisionDriven", true),
        ]),
        new("IPolicyWonk", Icons.Material.Outlined.Gavel, "p",
        [
            new("bool", "StaysInformed", true),
            new("bool", "FollowsIncentives", true),
            new("bool", "DebateReady", true),
            new("string[]", "Topics", new[] { "Economics", "Trade", "Energy", "Tech" }),
            new("string", "Philosophy", "It's About Incentives"),
            new("bool", "BigPictureThinker", true),
        ]),
        new("IGamer", Icons.Material.Outlined.SportsEsports, "g",
        [
            new("bool", "Competitive", true),
            new("bool", "Strategic", true),
            new("bool", "TeamPlayer", true),
            new("bool", "OneMoreRound", true),
            new("string[]", "Titles", new[] { "Tarkov", "CS2", "Civ VI" }),
            new("string", "Platform", "PC"),
        ]),
        new("IAudiophile", Icons.Material.Outlined.Headphones, "m",
        [
            new("bool", "AlwaysListening", true),
            new("bool", "CuratesPlaylists", true),
            new("bool", "AppreciatesBass", true),
            new("string[]", "Genres", new[] { "Hip-Hop", "R&B", "Electronic" }),
            new("string", "Setup", "Open-Back + DAC/Amp"),
            new("bool", "HeadphonesOn", true),
        ]),
    ];

    private static readonly Member[] CoreProperties =
    [
        new("string", "Name", "Sam Elhag"),
        new("string", "OnlineAlias", "Sam.E"),
        new("int", "YearsExperience", 6),
        new("bool", "CaffeineRequired", true),
        new("string", "CurrentLocation", "Pittsburgh, PA, USA"),
        new("string", "BirthLocation", "Khartoum, Sudan"),
        new("string", "Nationality", "American"),
    ];

    // Every value passes through Span/HtmlEncode before it is emitted as markup.
    private static string Span(string cssClass, string text) => $"<span class=\"{cssClass}\">{WebUtility.HtmlEncode(text)}</span>";

    private static string Literal(object value) => value switch
    {
        bool flag => Span("syn-kw", flag ? "true" : "false"),
        int number => Span("syn-num", number.ToString(CultureInfo.InvariantCulture)),
        string text => Span("syn-str", $"\"{text}\""),
        string[] items => $"{Span("syn-kw", "new")}[] {{ {string.Join(", ", items.Select(item => Span("syn-str", $"\"{item}\"")))} }}",
        _ => WebUtility.HtmlEncode(value.ToString() ?? string.Empty),
    };

    private static MarkupString InterfaceCode(Facet facet)
    {
        var code = new StringBuilder()
            .Append(Span("syn-kw", "public interface")).Append(' ').Append(Span($"syn-iface--{facet.Tone}", facet.Name)).Append("\n{\n");
        foreach (var member in facet.Members)
        {
            code.Append("    ").Append(Span("syn-kw", member.Type)).Append(' ').Append(Span("syn-prop", member.Name))
                .Append(" { ").Append(Span("syn-kw", "get")).Append("; }\n");
        }
        return new MarkupString(code.Append('}').ToString());
    }

    private static MarkupString ImplementationCode(Facet facet) =>
        new(Span("syn-comment", $"// {facet.Name}") + "\n" +
            string.Join("\n", facet.Members.Select(m => $"{Span("syn-prop", m.Name)} => {Literal(m.Value)};")));

    private static MarkupString CoreCode() =>
        new(Span("syn-comment", "// Core Properties") + "\n" +
            string.Join("\n", CoreProperties.Select(m => $"{Span("syn-kw", $"public {m.Type}")} {Span("syn-prop", m.Name)} => {Literal(m.Value)};")));

    private static MarkupString ClassDeclaration() =>
        new($"{Span("syn-kw", "public class")} {Span("syn-tp", "SamE")} : " +
            string.Join(", ", Facets.Select(f => Span($"syn-iface--{f.Tone}", f.Name))));
}
