@page "/projects"

<Seo Title="Projects"
     Description="Engineering software that bridges domains, featuring a real-time NACA 0012 heat-transfer simulation built with .NET 10, Blazor, and the Canvas API."
     Path="/projects" />

<div class="container">
    <PageHeader Eyebrow="~/projects" Title="Projects">
        Engineering software that bridges domains.
    </PageHeader>

    @if (ProjectCatalog.Featured is { } featured)
    {
        <ProjectCard Project="featured" Featured="true" HeadingLevel="2" Eyebrow="Featured" />
    }

    @* New entries in ProjectCatalog appear here automatically. *@
    <div class="grid-auto projects-grid">
        @foreach (var project in ProjectCatalog.Others)
        {
            <ProjectCard Project="project" HeadingLevel="2" />
        }

        <article class="card card--dashed more-card" aria-labelledby="more-title">
            <span class="icon-tile icon-tile--sm"><Icon Svg="@Icons.Custom.Brands.GitHub" /></span>
            <div class="more-card__text">
                <h2 id="more-title" class="more-card__title">More on the way</h2>
                <p class="muted">New projects are in progress. In the meantime, browse my code on GitHub.</p>
            </div>
            <a class="btn btn--sm" href="@SiteInfo.GitHubUrl" target="_blank" rel="noopener noreferrer">
                github.com/SamElhagDev
                <Icon Svg="@Icons.Material.Outlined.OpenInNew" />
            </a>
        </article>
    </div>
</div>
