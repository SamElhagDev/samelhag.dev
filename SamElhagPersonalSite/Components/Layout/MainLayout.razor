@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Nav

<MudThemeProvider IsDarkMode="true" Theme="@SiteTheme.Theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

@* Visible on keyboard focus only; site-interop.js moves focus into <main>. *@
<a class="skip-link" href="#main-content">Skip to content</a>

<MudLayout>
    <MudAppBar Elevation="0" Gutters="false" Class="site-header" inert="@_drawerOpen">
        <div class="container site-header__inner">
            <a class="brand" href="/" aria-label="Sam.E, home">
                <span class="brand__bracket" aria-hidden="true">[</span>Sam.E<span class="brand__bracket" aria-hidden="true">]</span>
            </a>

            <NavMenu />

            <div class="site-header__actions">
                @* command-palette.js opens on clicks to .cmdk-trigger and adds .is-mac to <html> to pick the keycap. *@
                <button type="button" class="cmdk-trigger" aria-label="Search the site" aria-keyshortcuts="Control+K Meta+K">
                    <Icon Svg="@Icons.Material.Outlined.Search" />
                    <span class="cmdk-trigger-label" aria-hidden="true">Search</span>
                    <kbd class="cmdk-trigger-keys" aria-hidden="true"><span class="kbd-mac">⌘K</span><span class="kbd-other">Ctrl K</span></kbd>
                </button>
                <button type="button" class="icon-btn menu-toggle" @ref="_menuToggle" @onclick="OpenDrawer"
                        aria-label="Open menu" aria-controls="site-drawer" aria-expanded="@(_drawerOpen ? "true" : "false")">
                    <Icon Svg="@Icons.Material.Outlined.Menu" />
                </button>
            </div>
        </div>
    </MudAppBar>

    <MudDrawer Open="_drawerOpen" OpenChanged="OnDrawerOpenChanged" Variant="DrawerVariant.Temporary"
               Anchor="Anchor.End" Width="300px" Elevation="0" Class="site-drawer" id="site-drawer">
        <div class="drawer-panel" inert="@(!_drawerOpen)" @onkeydown="OnDrawerKeyDown">
            <div class="drawer-panel__head">
                <span class="brand" aria-hidden="true"><span class="brand__bracket">[</span>Sam.E<span class="brand__bracket">]</span></span>
                <button type="button" class="icon-btn" @ref="_drawerClose" @onclick="CloseDrawer" aria-label="Close menu">
                    <Icon Svg="@Icons.Material.Outlined.Close" />
                </button>
            </div>

            <NavMenu Vertical="true" />

            <ul class="social-links drawer-panel__social" role="list">
                @foreach (var link in SiteInfo.Social)
                {
                    <li>
                        <a class="icon-btn" href="@link.Url" target="_blank" rel="noopener noreferrer" aria-label="@link.Label">
                            <Icon Svg="@link.Icon" />
                        </a>
                    </li>
                }
            </ul>
        </div>
    </MudDrawer>

    <MudMainContent Class="site-shell" inert="@_drawerOpen">
        <main id="main-content" class="site-main" tabindex="-1">
            @Body
        </main>
        <SiteFooter />
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private enum FocusTarget { None, DrawerClose, MenuToggle }

    private bool _drawerOpen;
    private FocusTarget _pendingFocus;
    private ElementReference _menuToggle;
    private ElementReference _drawerClose;

    protected override void OnInitialized() => Nav.LocationChanged += OnLocationChanged;

    // Focus moves after the render that toggles `inert`, otherwise the target isn't focusable yet.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var target = _pendingFocus;
        _pendingFocus = FocusTarget.None;

        if (target == FocusTarget.DrawerClose)
        {
            await _drawerClose.FocusAsync();
        }
        else if (target == FocusTarget.MenuToggle)
        {
            await _menuToggle.FocusAsync();
        }
    }

    private void OpenDrawer()
    {
        _drawerOpen = true;
        _pendingFocus = FocusTarget.DrawerClose;
    }

    private void CloseDrawer()
    {
        if (!_drawerOpen)
        {
            return;
        }

        _drawerOpen = false;
        _pendingFocus = FocusTarget.MenuToggle;
    }

    // MudDrawer reports false when its overlay is clicked.
    private void OnDrawerOpenChanged(bool open)
    {
        if (!open)
        {
            CloseDrawer();
        }
    }

    private void OnDrawerKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            CloseDrawer();
        }
    }

    // Following a link inside the drawer closes it; FocusOnNavigate then focuses the new page's h1.
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (!_drawerOpen)
        {
            return;
        }

        _drawerOpen = false;
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
