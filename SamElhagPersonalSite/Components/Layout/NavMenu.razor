@* Primary navigation: a horizontal bar in the desktop header and a stacked list in the
   mobile drawer. Links come from SiteInfo.Navigation; NavLink marks the current page. *@
<nav class="@(Vertical ? "drawer-nav" : "site-nav")" aria-label="Primary">
    <ul class="@(Vertical ? "drawer-nav__list" : "site-nav__list")" role="list">
        @foreach (var item in SiteInfo.Navigation)
        {
            <li>
                <NavLink class="@(Vertical ? "drawer-nav__link" : "site-nav__link")" href="@item.Href" Match="@item.Match">@item.Label</NavLink>
            </li>
        }
    </ul>
</nav>

@code {
    /// <summary>Render as the stacked list used inside the mobile drawer.</summary>
    [Parameter] public bool Vertical { get; set; }
}
