@using System.Text.Json
@using samelhag.dev.Services
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#131110" />
    <meta name="author" content="@SiteInfo.Name" />
    <ResourcePreloader />

    @* Variable fonts: one file per family rather than one per weight. *@
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300..800&family=JetBrains+Mono:wght@400..700&family=Space+Grotesk:wght@400..700&display=swap" />

    @* MudBlazor first, so the site's own styles win on specificity alone. *@
    <link rel="stylesheet" href="@Assets["_content/MudBlazor/MudBlazor.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["samelhag.dev.styles.css"]" />

    <link rel="icon" href="@Assets["favicon.svg"]" type="image/svg+xml" />
    <link rel="icon" href="@Assets["favicon.png"]" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="@Assets["apple-touch-icon.png"]" />
    <link rel="manifest" href="@Assets["site.webmanifest"]" />

    @StructuredDataScript

    <ImportMap nonce="@Nonce" />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body>
    @* Decorative animated maze behind every page; lives outside the router so it survives navigation. *@
    <canvas id="bg" class="maze-bg" data-permanent aria-hidden="true"></canvas>

    <Routes @rendermode="PageRenderMode" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["_content/MudBlazor/MudBlazor.min.js"]"></script>
    <script src="@Assets["js/site-interop.js"]"></script>
    <script src="@Assets["js/heatSimulation.js"]"></script>
    <script src="@Assets["js/maze-background.js"]"></script>
    <script src="@Assets["js/command-palette.js"]"></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    // Every page is prerendered, then becomes interactive — except pages marked
    // [ExcludeFromInteractiveRouting] (the error page), which must stay static to read HttpContext.
    private IComponentRenderMode? PageRenderMode =>
        HttpContext.AcceptsInteractiveRouting() ? InteractiveServer : null;

    // Per-request CSP nonce, set by the response-header middleware in Program.cs.
    private string? Nonce => CspNonce.From(HttpContext);

    // Base64, so it cannot break out of the attribute it is interpolated into.
    private MarkupString StructuredDataScript =>
        new($"<script type=\"application/ld+json\" nonce=\"{Nonce}\">{StructuredDataJson}</script>");

    // schema.org Person data for search engines. JsonSerializer escapes '<' and '&', so it is safe inside <script>.
    private static readonly string StructuredDataJson =
        JsonSerializer.Serialize(new Dictionary<string, object>
        {
            ["@context"] = "https://schema.org",
            ["@type"] = "Person",
            ["name"] = SiteInfo.Name,
            ["alternateName"] = SiteInfo.Alias,
            ["jobTitle"] = SiteInfo.Role,
            ["url"] = SiteInfo.BaseUrl,
            ["address"] = new Dictionary<string, object>
            {
                ["@type"] = "PostalAddress",
                ["addressLocality"] = "Pittsburgh",
                ["addressRegion"] = "PA",
                ["addressCountry"] = "US",
            },
            ["sameAs"] = new[] { SiteInfo.GitHubUrl, SiteInfo.LinkedInUrl, SiteInfo.XUrl },
        });
}
