@page "/interests"

<Seo Title="Interests"
     Description="What Sam Elhag listens to, watches, plays, and tinkers with when not building software, from IDM and sci-fi to microcontrollers and industrial design."
     Path="/interests" />

<div class="container">
    <PageHeader Eyebrow="~/interests" Title="Interests">
        What I consume when I'm not building.
    </PageHeader>

    <div class="grid-auto">
        @foreach (var category in Categories)
        {
            <section class="card" aria-labelledby="interest-@category.Id">
                <div class="card__head">
                    <span class="icon-tile"><Icon Svg="@category.Icon" /></span>
                    <h2 id="interest-@category.Id" class="card__title">@category.Title</h2>
                </div>
                <ul class="tag-list" role="list">
                    @foreach (var item in category.Items)
                    {
                        <li class="tag">@item</li>
                    }
                </ul>
            </section>
        }
    </div>
</div>

@code {
    private sealed record Category(string Id, string Title, string Icon, string[] Items);

    private static readonly Category[] Categories =
    [
        new("music", "Music", Icons.Material.Outlined.LibraryMusic,
            ["Aphex Twin", "µ-Ziq", "Squarepusher", "Rob Clouth", "Telefon Tel Aviv", "Jon Hopkins", "Boards Of Canada", "Polygon Window", "Arovane", "Wisp", "Roni Size Reprazent", "Daft Punk"]),
        new("screen", "TV and movies", Icons.Material.Outlined.Tv,
            ["The Expanse", "Dune", "Interstellar", "Oppenheimer", "Blade Runner 2049", "Chernobyl", "For All Mankind", "Foundation", "Band of Brothers", "The Wire", "Severance", "Arcane"]),
        new("gaming", "Gaming", Icons.Material.Outlined.SportsEsports,
            ["Escape from Tarkov", "CS2", "Civ VI", "Rust", "Homeworld 2", "WARNO", "Insurgency: Sandstorm", "Fallout 4"]),
        new("firearms", "Firearms", Icons.Material.Outlined.GpsFixed,
            ["AR-15", "AK Platform", "Bolt-action rifles", "Pistols", "9mm", "5.56 NATO", ".308 Win", "Optics", "Marksmanship", "Range days", "Reloading"]),
        new("art", "Art", Icons.Material.Outlined.FormatPaint,
            ["Generative art", "Bauhaus", "Brutalist architecture", "Industrial design", "Typography", "Minimalism", "Concept art", "Photography", "Data visualization", "Mid-century modern"]),
        new("electronics", "Electronics", Icons.Material.Outlined.ElectricBolt,
            ["Arduino", "Raspberry Pi", "ESP32", "Microcontrollers", "Soldering", "SolidWorks", "3D printing", "Mechanical keyboards", "DAC/Amp", "Home lab", "Hi-Fi"]),
    ];
}
