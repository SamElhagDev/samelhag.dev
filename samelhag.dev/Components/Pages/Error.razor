@page "/error"
@using System.Diagnostics
@* Rendered statically: it reads HttpContext, which interactive rendering doesn't provide. *@
@attribute [ExcludeFromInteractiveRouting]

<Seo Title="Error" Description="Something went wrong while processing your request." Path="/error" NoIndex="true" />

<div class="container">
    <header class="page-header">
        <p class="eyebrow eyebrow--path">~/error</p>
        <h1 class="page-title">Something went wrong</h1>
        <p class="lead">An error occurred while processing your request. Please try again, or head back to the home page.</p>
    </header>

    <div class="stack">
        @if (ShowRequestId)
        {
            <p class="muted">Request ID: <code>@RequestId</code></p>
        }
        <div class="cluster">
            <a class="btn btn--primary" href="/">Back to home</a>
        </div>
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
