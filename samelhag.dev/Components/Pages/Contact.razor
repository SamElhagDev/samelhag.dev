@page "/contact"
@using System.ComponentModel.DataAnnotations
@using samelhag.dev.Models
@using samelhag.dev.Services
@inject ISnackbar Snackbar
@inject IEmailService EmailService
@inject ILogger<Contact> Logger

<Seo Title="Contact"
     Description="Contact Sam Elhag about a project or collaboration."
     Path="/contact" />

<div class="container">
    <PageHeader Eyebrow="~/contact" Title="Get in touch">
        If you have a project in mind or want to collaborate, send me a message.
    </PageHeader>

    <div class="contact-layout">
        <section class="card" aria-labelledby="form-title">
            <h2 id="form-title" class="card__title contact-card__title">Send me a message</h2>

            <MudForm @ref="_form">
                <div class="contact-form__grid">
                    <MudTextField @bind-Value="_model.FirstName" Label="First name" Variant="Variant.Outlined" MaxLength="100"
                                  Required="true" RequiredError="First name is required" autocomplete="given-name" />
                    <MudTextField @bind-Value="_model.LastName" Label="Last name" Variant="Variant.Outlined" MaxLength="100"
                                  Required="true" RequiredError="Last name is required" autocomplete="family-name" />
                    <MudTextField @bind-Value="_model.Email" Label="Email" Variant="Variant.Outlined" InputType="InputType.Email"
                                  MaxLength="254" Required="true" RequiredError="Email is required" autocomplete="email" Class="span-full"
                                  Validation="@(new EmailAddressAttribute { ErrorMessage = "Invalid email address" })" />
                    <MudTextField @bind-Value="_model.Subject" Label="Subject" Variant="Variant.Outlined" MaxLength="200"
                                  Required="true" RequiredError="Subject is required" Class="span-full" />
                    <MudTextField @bind-Value="_model.Message" Label="Message" Variant="Variant.Outlined" Lines="6" MaxLength="10000"
                                  Required="true" RequiredError="Message is required" Class="span-full" />
                </div>

                @* Decoy field: off-screen, untabbable, hidden from assistive tech, so only a bot
                   filling inputs blindly will populate it. Never shown to a real visitor. *@
                <div class="contact-form__decoy" aria-hidden="true">
                    <label for="contact-website">Website</label>
                    <input id="contact-website" name="website" type="text"
                           tabindex="-1" autocomplete="off" @bind="_decoy" />
                </div>

                <button type="button" class="btn btn--primary btn--lg btn--block contact-form__submit"
                        disabled="@_isSubmitting" @onclick="SubmitAsync">
                    <Icon Svg="@Icons.Material.Outlined.Send" />
                    @(_isSubmitting ? "Sending…" : "Send message")
                </button>
            </MudForm>
        </section>

        <aside class="contact-aside" aria-label="Other ways to reach me">
            <section class="card" aria-labelledby="details-title">
                <h2 id="details-title" class="card__title contact-card__title">Contact information</h2>
                <ul class="contact-details" role="list">
                    <li>
                        <span class="icon-tile icon-tile--sm"><Icon Svg="@Icons.Material.Outlined.Email" /></span>
                        <div>
                            <span class="contact-details__label">Email</span>
                            <a href="@($"mailto:{SiteInfo.Email}")">@SiteInfo.Email</a>
                        </div>
                    </li>
                    <li>
                        <span class="icon-tile icon-tile--sm"><Icon Svg="@Icons.Material.Outlined.Phone" /></span>
                        <div>
                            <span class="contact-details__label">Phone</span>
                            <a href="@SiteInfo.PhoneHref">@SiteInfo.Phone</a>
                        </div>
                    </li>
                    <li>
                        <span class="icon-tile icon-tile--sm"><Icon Svg="@Icons.Material.Outlined.LocationOn" /></span>
                        <div>
                            <span class="contact-details__label">Location</span>
                            <span class="contact-details__value">@SiteInfo.Location</span>
                        </div>
                    </li>
                </ul>
            </section>

            <section class="card" aria-labelledby="social-title">
                <h2 id="social-title" class="card__title contact-card__title">Connect with me</h2>
                <div class="stack contact-social">
                    @foreach (var link in SiteInfo.Social)
                    {
                        <a class="btn btn--block" href="@link.Url" target="_blank" rel="noopener noreferrer">
                            <Icon Svg="@link.Icon" />
                            @link.Label
                        </a>
                    }
                </div>
            </section>
        </aside>
    </div>
</div>

@code {
    // Nobody fills in a form this fast, so anything quicker than this is automation.
    private static readonly TimeSpan MinimumFillTime = TimeSpan.FromSeconds(3);

    private MudForm? _form;
    private bool _isSubmitting;
    private ContactFormModel _model = new();

    // Honeypot. Not part of ContactFormModel: it is an anti-bot artifact, not contact data, and
    // keeping it out means the model EmailService validates stays exactly the submitted message.
    private string _decoy = string.Empty;

    // Set on the first interactive render, which prerendering does not reach, so this is the moment
    // the form actually became usable in the browser.
    private DateTimeOffset? _formReadyAt;

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            _formReadyAt = DateTimeOffset.UtcNow;
        }
    }

    private async Task SubmitAsync()
    {
        await _form!.ValidateAsync();

        if (!_form.IsValid)
        {
            Snackbar.Add("Please fix the errors in the form.", Severity.Warning);
            return;
        }

        if (!string.IsNullOrWhiteSpace(_decoy))
        {
            // Logged rather than silent: if this ever fires on a genuine submission (an aggressive
            // autofill, say), there is a record of the message having been dropped.
            Logger.LogWarning("Contact form submission dropped: decoy field was populated.");
            await ReportSentAsync();
            return;
        }

        if (_formReadyAt is { } readyAt && DateTimeOffset.UtcNow - readyAt < MinimumFillTime)
        {
            Logger.LogWarning("Contact form submission dropped: submitted faster than a human can type.");
            Snackbar.Add("That came through a little fast. Give it a moment and send again.", Severity.Warning);
            return;
        }

        _isSubmitting = true;
        try
        {
            var result = await EmailService.SendContactEmailAsync(_model);

            if (result == ContactSendResult.RateLimited)
            {
                Snackbar.Add("The form is busy right now. Please try again in a few minutes, or email me directly.", Severity.Warning);
                return;
            }

            await ReportSentAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to send contact email.");
            Snackbar.Add("Something went wrong sending your message. Please try again later.", Severity.Error);
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    // Shown for a real send and for a dropped bot submission alike, so the filter is not discoverable.
    private async Task ReportSentAsync()
    {
        Snackbar.Add("Message sent. I'll get back to you soon.", Severity.Success);

        _model = new ContactFormModel();
        _decoy = string.Empty;
        await _form!.ResetAsync();
    }
}
