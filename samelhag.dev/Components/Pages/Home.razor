@page "/"

<Seo Title="@($"{SiteInfo.Name} — {SiteInfo.Role}")"
     Description="Mechanical and software engineer in Pittsburgh, PA. Numerical methods and production .NET, including a real-time CFD solver that runs in your browser."
     Path="/" />

<section class="hero" aria-labelledby="hero-title">
    <div class="container hero__inner">
        <p class="eyebrow eyebrow--path">$ whoami</p>
        <h1 id="hero-title" class="display hero__title">Sam Elhag</h1>
        <p class="hero__role">
            <span class="role-flip" aria-hidden="true"><span class="role-flip__window"><span class="role-flip__sizer">Mechanical</span><span class="role-flip__stack"><span>Mechanical</span><span>Software</span><span>Mechanical</span></span></span><span class="role-flip__static">Mechanical / Software</span></span><span class="visually-hidden">Mechanical and Software</span> Engineer
        </p>
        <p class="lead hero__lead">
            I move between numerical methods and production code: finite-difference CFD one day, a .NET service the next.
            The CFD solver featured below runs live in your browser — not a screenshot.
        </p>
        <div class="cluster hero__actions">
            <a class="btn btn--primary btn--lg" href="/projects">
                View my work
                <Icon Svg="@Icons.Material.Outlined.ArrowForward" Class="icon--trailing" />
            </a>
            <a class="btn btn--lg" href="/contact">
                <Icon Svg="@Icons.Material.Outlined.Email" />
                Get in touch
            </a>
        </div>
    </div>
</section>

@if (ProjectCatalog.Featured is { } featured)
{
    <section class="section section--flush-top" aria-labelledby="featured-title">
        <div class="container">
            <header class="section-head">
                <div>
                    <p class="eyebrow">Featured</p>
                    <h2 id="featured-title" class="section-title">Real-time CFD, in your browser</h2>
                    <p class="lead">Computational physics meets modern web development.</p>
                </div>
            </header>
            <ProjectCard Project="featured" Featured="true" />
        </div>
    </section>
}

<section class="section section--flush-top" aria-labelledby="stack-title">
    <div class="container">
        <header class="section-head">
            <div>
                <p class="eyebrow">Stack</p>
                <h2 id="stack-title" class="section-title">Technologies &amp; tools</h2>
                <p class="lead">An honest map of what I reach for — grouped by how often I actually use it.</p>
            </div>
        </header>

        <div class="stack-tiers">
            @foreach (var tier in StackTiers)
            {
                <section class="card stack-tier" aria-labelledby="@tier.Id">
                    <h3 id="@tier.Id" class="stack-tier__label">@tier.Label</h3>
                    <ul class="tag-list" role="list">
                        @foreach (var item in tier.Items)
                        {
                            <li class="tag @tier.TagClass">@item</li>
                        }
                    </ul>
                </section>
            }
        </div>
    </div>
</section>

<div class="container home-cta">
    <a class="btn btn--lg" href="/projects">
        View all projects
        <Icon Svg="@Icons.Material.Outlined.ArrowForward" Class="icon--trailing" />
    </a>
</div>

@code {
    private sealed record StackTier(string Id, string Label, string TagClass, string[] Items);

    // Grouped by how often each tool is actually used, not by category.
    private static readonly StackTier[] StackTiers =
    [
        new("tier-daily", "Build with daily", "tag--accent", ["C#", ".NET", "Blazor", "ASP.NET", "SQL Server / T-SQL", "TypeScript", "Azure"]),
        new("tier-comfortable", "Comfortable in", "tag--strong", ["Rust", "F#", "Angular", "EF Core", "Docker", "Redis"]),
        new("tier-engineering", "Engineering side", "", ["MATLAB", "SolidWorks", "AutoCAD"]),
    ];
}
